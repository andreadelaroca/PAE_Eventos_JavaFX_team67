<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.equipo67.controladores.MenuController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <Label text="Menú de ejercicios" style="-fx-font-size: 40px"/>
    <Label text="¿A qué pantalla desea ingresar?"/>
    <VBox alignment="CENTER">
        <ListView fx:id="lsvwPantalla" prefHeight="100"/>
        <Button fx:id="btnIniciarPantalla" text="Entrar" onAction="#entrarOnClick"/>
    </VBox>
</VBox>
